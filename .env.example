# ── Provider API keys (server-side only; never exposed to the browser) ──────
# Required for news/telegram scraping: https://firecrawl.dev
FIRECRAWL_API_KEY=

# AI gateway (OpenRouter). Powers every AI panel — OSINT items, hot-topics
# timeline, analyst commentary, bias tracker, news/telegram extraction, and
# Arabic translation. URL is optional and defaults to OpenRouter; the key is
# required. Models default to Perplexity's sonar / sonar-pro (same models
# this dashboard always used, now billed through one shared gateway key
# instead of a separate Perplexity account) — override only if you want a
# different pair.
AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
AI_GATEWAY_KEY=
OPENROUTER_LIGHT_MODEL=perplexity/sonar
OPENROUTER_MID_MODEL=perplexity/sonar-pro

# Max events returned per conflict timeline (older history stays in Postgres;
# this just caps the response payload, mainly for the Arabic translation
# panel's input size limit). Default 40 if unset.
TIMELINE_MAX_EVENTS=40

# Static bearer token protecting /api/audit-refresh, /api/admin/diagnostics
# and /api/admin/costs. Pick any long random string.
ADMIN_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (running `npm run dev` in server/ against your own Postgres).
# docker-compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://osint:osint@localhost:5432/osint

# docker-compose Postgres credentials (change the password in production).
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint

# ── Ports ────────────────────────────────────────────────────────────────────
# Public port for the web container (NOT 80 — that collides with the host's
# reverse proxy).
WEB_PORT=8081
