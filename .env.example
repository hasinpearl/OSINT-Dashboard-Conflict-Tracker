# Provider API keys (server-side only, never exposed to the browser)
# Required for news/telegram scraping: https://firecrawl.dev
FIRECRAWL_API_KEY=

# AI gateway (OpenRouter). Powers every AI panel, including Arabic translation.
# Key required, URL optional. Models default to Perplexity's sonar / sonar-pro.
AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
AI_GATEWAY_KEY=
# TUNE: Control the AI model tier
OPENROUTER_LIGHT_MODEL=perplexity/sonar
OPENROUTER_MID_MODEL=perplexity/sonar-pro

# TUNE: Control the max timeline events returned per response
TIMELINE_MAX_EVENTS=40

# Bearer token protecting /api/audit-refresh, /api/admin/diagnostics,
# /api/admin/costs. Pick any long random string.
ADMIN_TOKEN=

# Database
# Local dev (running npm run dev in server/ against your own Postgres).
# docker-compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://osint:osint@localhost:5432/osint

# docker-compose Postgres credentials (change the password in production).
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint

# Ports
# Public port for the web container. Not 80, that collides with the host's
# reverse proxy.
WEB_PORT=8081

# Map widget (browser). VITE_ vars are compiled into the bundle and are visible
# to anyone who loads the page, so nothing secret belongs here.
#
# TUNE: Control the (mapbox style). VITE_MAPBOX_STYLE=style URL the map renders.
VITE_MAPBOX_STYLE=mapbox://styles/hammadihessa/cmtzq5jim00e301qy9uz19lhy
# TUNE: Control the (mapbox token). VITE_MAPBOX_TOKEN=public pk. token for the map.
# The pk. token is public by design: Mapbox expects it in client code and it
# cannot be kept secret in a browser bundle. It still belongs ONLY in your
# private .env, never committed, and it should be URL-restricted in the Mapbox
# account (Account > Tokens > URL restrictions) so nobody else can spend your
# quota with it. Leave blank and the map panel renders a placeholder instead.
VITE_MAPBOX_TOKEN=

# Geocoding (server). OpenStreetMap Nominatim, free and keyless.
#
# TUNE: Control the (nominatim user agent). GEOCODE_USER_AGENT=contact string sent to OSM, required by their policy.
# Nominatim blocks generic agents. Identify the app and a real contact.
GEOCODE_USER_AGENT=OSINT-Dashboard-Conflict-Tracker/1.0 (+https://hessaa.net)
# TUNE: Control the (nominatim rate limit). GEOCODE_MIN_INTERVAL_MS=minimum gap between requests, 1000 is OSM's stated floor.
GEOCODE_MIN_INTERVAL_MS=1100
# TUNE: Control the (geocode sweep rate). GEOCODE_POLL_SECONDS=seconds between passes over rows with no location yet.
GEOCODE_POLL_SECONDS=120
# TUNE: Control the (nominatim host). NOMINATIM_URL=geocoding endpoint, defaults to the public OSM instance.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Collection. The workers poll these; panels read what the workers stored.
#
# TUNE: Control the (rss feeds). RSS_FEEDS=comma separated feed URLs polled every round.
# OPTIONAL. Leave it unset and the RSS worker uses its built-in default list
# (server/src/workers/rss.ts, DEFAULT_RSS_FEEDS), so a deploy with no env config
# at all still ingests. Set this only to override that list. The worker logs
# which list is in use on every start.
# Every feed below was tested live on 2026-09-13.
RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.bbci.co.uk/news/business/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www.aljazeera.net/aljazeerarss,https://www.france24.com/en/rss,https://news.un.org/feed/subscribe/en/news/all/rss.xml,https://feeds.content.dowjones.io/public/rss/mw_topstories,https://techcrunch.com/category/artificial-intelligence/feed/,https://arstechnica.com/ai/feed/,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/rss,https://news.google.com/rss/headlines/section/topic/WORLD?hl=en-US&gl=US&ceid=US:en,https://news.google.com/rss/headlines/section/topic/TECHNOLOGY?hl=en-AE&gl=AE&ceid=AE:en,https://www.jpost.com/rss/rssfeedsfrontpage.aspx,https://www.jpost.com/rss/rssfeedsarabisraeliconflict.aspx,https://www.space.com/feeds/all
#
# Known issues in the list above, kept so they are visible rather than silently dropped:
#   mw_marketpulse        Dow Jones stopped updating it. Newest item is over a year old.
#                         Not in the list, and not in the built-in default either.
#   jpost_mideast         rssfeedsmiddleeast.aspx returns 404. Swapped to
#                         rssfeedsarabisraeliconflict.aspx, which serves 30 items.
#   JPost pubDates        JPost stamps pubDate a few hours ahead. The worker clamps
#                         future dates to now() at insert.
# Any feed that fails is reported per feed by GET /api/sources, with the real error.
#
# TUNE: Control the (rss poll rate). RSS_POLL_SECONDS=seconds between polling rounds.
RSS_POLL_SECONDS=120
# TUNE: Control the (circuit breaker). RSS_MAX_BACKOFF=most consecutive failing rounds before a feed is retried.
RSS_MAX_BACKOFF=10
# TUNE: Control the (per feed batch). RSS_MAX_ENTRIES_PER_ROUND=entries read from a single feed in one round.
RSS_MAX_ENTRIES_PER_ROUND=50
# TUNE: Control the (feed fetch timeout). RSS_FETCH_TIMEOUT_MS=milliseconds a single feed request may take.
RSS_FETCH_TIMEOUT_MS=20000
# TUNE: Control the (feed user agent). RSS_USER_AGENT=identity sent to publishers, some reject a blank or generic one.
RSS_USER_AGENT=OSINT-Dashboard-Conflict-Tracker/1.0 (+https://hessaa.net)

# Tokened feeds such as registered WAM URLs belong ONLY in your private .env, never committed.
# WAM publishes no usable public RSS; the public pattern returns zero entries.
# Append them to RSS_FEEDS separated by commas.

# TUNE: Control the (telegram channels). TG_PREVIEW_CHANNELS=comma separated public channel usernames.
TG_PREVIEW_CHANNELS=monitor_the_situation,intelslava,GeoPWatch,rnintel,CIG_telegram,idkunim_il,OSINTdefender,BellumActaNews,RocketAlert
# TUNE: Control the (preview poll rate). TG_PREVIEW_POLL_SECONDS=seconds between polling rounds.
TG_PREVIEW_POLL_SECONDS=120
# TUNE: Control the (backfill depth). TG_PREVIEW_MAX_PAGES=history pages walked per channel per run, 20 posts each.
TG_PREVIEW_MAX_PAGES=25
# TUNE: Control the (request pacing). TG_PREVIEW_DELAY_SECONDS=seconds between channel requests.
TG_PREVIEW_DELAY_SECONDS=2
# TUNE: Control the (redirect depth). TG_PREVIEW_MAX_REDIRECTS=hops followed before a request is abandoned.
TG_PREVIEW_MAX_REDIRECTS=5

# MTProto collector. Optional. When TG_API_ID is set the workers use it instead of the
# public preview, which adds live push and private channels.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# TUNE: Control the (channel cap). TG_MAX_CHANNELS=hard limit on watched channels.
TG_MAX_CHANNELS=40
# TUNE: Control the (resolve pacing). TG_RESOLVE_DELAY_SECONDS=pause between channel lookups at startup.
TG_RESOLVE_DELAY_SECONDS=5
# TUNE: Control the (heartbeat). TG_HEARTBEAT_SECONDS=how often the worker reports it is alive.
TG_HEARTBEAT_SECONDS=120
