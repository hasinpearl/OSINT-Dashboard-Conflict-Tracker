# ── Provider API keys (server-side only; never exposed to the browser) ──────
# Required for news/telegram scraping: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Required for AI analysis: https://www.perplexity.ai/api/
PERPLEXITY_API_KEY=

# Translation gateway (OpenRouter-compatible). URL is optional and defaults
# to OpenRouter; the key is required for the Arabic translation feature.
AI_GATEWAY_URL=https://openrouter.ai/api/v1/chat/completions
AI_GATEWAY_KEY=

# Static bearer token protecting /api/audit-refresh, /api/admin/diagnostics
# and /api/admin/costs. Pick any long random string.
ADMIN_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (running `npm run dev` in server/ against your own Postgres).
# docker-compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://osint:osint@localhost:5432/osint

# docker-compose Postgres credentials (change the password in production).
POSTGRES_USER=osint
POSTGRES_PASSWORD=osint
POSTGRES_DB=osint

# ── Ports ────────────────────────────────────────────────────────────────────
# Public port for the web container (NOT 80 — that collides with the host's
# reverse proxy).
WEB_PORT=8081
